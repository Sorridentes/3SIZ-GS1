  <folder name="Strategy" id="id-d4e129261cb142d3b511df088bb2f515" type="strategy"/>
  <folder name="Business" id="id-2d273f3499ce498da2c1a1ec6b098b09" type="business"/>
  <folder name="Application" id="id-2d2b703fd00146be8ce866045f0f564d" type="application"/>
  <folder name="Technology &amp; Physical" id="id-109736fd78f5493dada6a0bd29b2473a" type="technology"/>
  <folder name="Motivation" id="id-a571225a6e0144b681e04db938ff181b" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Estudantes e Futuros Profissionais" id="id-ffc0368fcc0b4f1c9d0a5a9d6e2ea09e"/>
    <element xsi:type="archimate:Driver" name="Auxiliar jovens em formação que precisam se preparar para profissões que ainda não existem." id="id-ab010fcef62f4492bd4f338900c46291"/>
    <element xsi:type="archimate:Meaning" name="Meaning" id="id-7314aaeb45f54dabbb838f4ccfcc9d16"/>
    <element xsi:type="archimate:Goal" name="Capacitar jovens a construírem carreiras dinâmicas e resilientes." id="id-f5d55f717b0f462480d680a729a5aa2f"/>
    <element xsi:type="archimate:Outcome" name="Preparar jovens  para permanecerem humanos em um mundo cada vez mais automatizado." id="id-de59b4492f364057b8bc8e7215a0eac4"/>
    <element xsi:type="archimate:Goal" name="Preparar jovens  para permanecerem humanos em um mundo cada vez mais automatizado." id="id-5cccca29fb194496af97fdf3d189eb5d"/>
    <element xsi:type="archimate:Outcome" name="Criar ambientes de trabalho adaptativos que promovem saúde mental, produtividade sustentável e desenvolvimento humano integral." id="id-01993fc316ba45db949101acf57dc21f"/>
    <element xsi:type="archimate:Outcome" name="Aumento do desenvolvimento de competências humanas (soft skill)" id="id-531448c08a2646019a5beda585132f2e"/>
    <element xsi:type="archimate:Outcome" name="Retenção dos conhecimentos adquiridos no curso em 85%" id="id-f070967d62ad4a3dbdb926b2a529610e"/>
    <element xsi:type="archimate:Assessment" name="Plataforma digital integrada que combina mentoria personalizada com IA, microlearning adaptativo e experiências práticas em ambientes virtuais" id="id-78ff130957d043daa2057e921091cef6"/>
    <element xsi:type="archimate:Requirement" name="Perfil customizado com uma dinamica de integração com IA" id="id-757f3bc0834b4ae88e1390d0ee693d4b"/>
    <element xsi:type="archimate:Constraint" name="Criar um perfil com testes de competências comportamentais (criatividade, pensamento crítico, colaboração, empatia), mapa de interesses alinhado a tendências de mercado e análise de lacunas que indica habilidades a desenvolver." id="id-af661164f04a4f77a0752daa243acc1c"/>
    <element xsi:type="archimate:Requirement" name="Reunião em ambiente de Simulação e Realidade Virtual" id="id-b09249a5206c438a81d5da870e5abfa6"/>
    <element xsi:type="archimate:Constraint" name="Realizar reuniões em espaços de trabalho virtuais onde alunos participam de reuniões híbridas simuladas, gerem projetos complexos com equipes distribuídas e praticam liderança, tomada de decisão e colaboração," id="id-b1d56c8e384f469a813ab5d04376298b"/>
    <element xsi:type="archimate:Requirement" name="Mentoria humanizada composta também de IA" id="id-8e68eecc2e2140188c2612b59fa1e44e"/>
    <element xsi:type="archimate:Constraint" name="Integrará um mentor IA disponível 24/7 para esclarecer dúvidas, sugerir conteúdos e oferecer feedback imediato, com uma rede de mentores humanos experientes" id="id-0c1e47ece5ed4d3b9d4b88d8e288867c"/>
    <element xsi:type="archimate:Assessment" name="Ecossistema integrado que usa monitoradores, IA generativa e realidade estendida" id="id-d977a8079e67415eaff26d9052c2607e"/>
    <element xsi:type="archimate:Requirement" name="Pulseira para monitorar variações de estado" id="id-0fa23b8ebbc84e8db65131548c012f52"/>
    <element xsi:type="archimate:Constraint" name="Pulseira monitora biomarcadores avançados como cortisol e variabilidade cardíaca, padrões de sono, níveis de energia e estresse cognitivo durante tarefas, fornecendo dados contínuos em tempo real ao assistente de IA pessoal para feedback, recomendações e otimização do desempenho e bem-estar." id="id-eb4c83989722459186b0b4f5ede10ca0"/>
  </folder>
